<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence 
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="metamapa-db" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        
        <!-- Clases de entidad JPA -->
        <class>utn.dds.jpa.entities.HechoEntity</class>
        <class>utn.dds.jpa.entities.ContribuyenteEntity</class>
        <class>utn.dds.jpa.entities.ColeccionEntity</class>
        <class>utn.dds.jpa.entities.FuenteEntity</class>
        <class>utn.dds.jpa.entities.SolicitudEliminacionEntity</class>
        
        <properties>
            <!-- Configuración de la base de datos -->
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/metamapa_db"/>
            <property name="jakarta.persistence.jdbc.user" value="metamapa"/>
            <property name="jakarta.persistence.jdbc.password" value="metamapa123"/>
            
            <!-- Configuración de Hibernate -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            
            <!-- Configuración de conexiones -->
            <property name="hibernate.connection.pool_size" value="10"/>
            <property name="hibernate.connection.autocommit" value="false"/>
            
            <!-- Configuración de logging -->
            <property name="hibernate.generate_statistics" value="false"/>
            
            <!-- Configuración de esquema -->
            <property name="hibernate.default_schema" value="public"/>
        </properties>
    </persistence-unit>
</persistence>