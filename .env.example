# ====================================
# Clerk Authentication Configuration
# ====================================
# Anda a   https://dashboard.clerk.com/
#  API Keys y copia la "Secret Key" (empieza con sk_test_ o sk_live_)
# Esta es la MISMA clave que usas en el frontend CLERK_SECRET_KEY
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# ====================================
# Base de datos PostgreSQL
# ====================================
POSTGRES_DB=metamapa_db
POSTGRES_USER=metamapa
POSTGRES_PASSWORD=metamapa123

# pgAdmin
PGADMIN_EMAIL=admin@metamapa.com
PGADMIN_PASSWORD=admin123

# MongoDB Configuration
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_USER=admin
MONGODB_PASSWORD=admin123
MONGODB_DB=metamapa_db
MONGODB_DB_DINAMICA=dinamica_db
MONGODB_DB_PROXY_DEMO=proxy_demo_db
MONGODB_AUTH_DB=admin

# MongoDB Atlas (Cloud) - Usar estas variables en producción
# MONGODB_URI=mongodb+srv://metamapa_user_mongo:TU_PASSWORD@metamapa.ki9gbfs.mongodb.net/?appName=MetaMapa
# Cuando uses MONGODB_URI, las variables MONGODB_HOST, MONGODB_PORT, MONGODB_USER, MONGODB_PASSWORD y MONGODB_AUTH_DB se ignoran

# MinIO S3 Configuration
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# S3 Configuration for Services
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=metamapa-data
S3_BUCKET_DINAMICA=dinamica-multimedia
S3_REGION=us-east-1

# Configuración de DAOs
AGREGADOR_DAO_TYPE=hibernate
METAMAPA_DAO_TYPE=hibernate
FUENTE_ESTATICA_DAO_TYPE=s3
FUENTE_DINAMICA_DAO_TYPE=mongodb
FUENTE_PROXY_DEMO_DAO_TYPE=mongodb

# ====================================
# Normalizador Configuration
# ====================================
# Habilitar/deshabilitar normalización de hechos
NORMALIZADOR_ENABLED=true